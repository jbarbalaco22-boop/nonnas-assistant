# Copy to .env for local runs. Never commit a real .env file.

# QuickBooks Online (OAuth2) — this app has its own independent connection/refresh token,
# deliberately NOT shared with nonnas-finance-audit or nonnas-daily-operator (QBO rotates the
# refresh token on every use — sharing one across independently-running processes breaks
# whichever one didn't refresh last).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=production

# Shopify (same custom app/credentials as the other two projects — read-only scopes, no
# rotation concern since it's a fresh client-credentials token every run, not a stored refresh
# token)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# One bearer token per person allowed to call /ask. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ASSISTANT_USERS={"cfo": "", "founder_1": "", "founder_2": ""}
